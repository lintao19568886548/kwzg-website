# Copy this file to /opt/kwzg-website/.env on the Linux server.
# Never commit the real file or paste its values into GitHub Actions logs.
KWZG_DB_NAME=kwzg_website
KWZG_DB_USER=kwzg_app
KWZG_DB_PASSWORD=replace-with-a-strong-random-password
KWZG_DB_ROOT_PASSWORD=replace-with-a-different-strong-random-password
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_TRUSTED_PROXY_ADDRESSES=replace-with-the-verified-docker-proxy-address
NUXT_TRUSTED_ORIGINS=https://yizuw.org,https://www.yizuw.org
KWZG_APP_PORT=9000
