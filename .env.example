# Docker Compose local runtime (copy to ignored .env and replace every secret)
KWZG_DB_NAME=kwzg_website
KWZG_DB_USER=kwzg_app
KWZG_DB_PASSWORD=replace-with-a-strong-local-password
KWZG_DB_ROOT_PASSWORD=replace-with-a-different-strong-local-password
KWZG_APP_PORT=3212

# Nuxt server-only runtime
NUXT_ADMIN_USERNAME=replace-with-admin-name
NUXT_ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-bytes
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3212
NUXT_PUBLIC_INDEXABLE=false
NUXT_ENABLE_HSTS=false
NUXT_TRUSTED_PROXY_ADDRESSES=

# Only needed when running the Node server outside Compose
NUXT_DATABASE_URL=mysql://kwzg_app:replace-with-a-strong-password@127.0.0.1:3306/kwzg_website
