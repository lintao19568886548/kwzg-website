# Production environment template. Copy to an ignored environment file and replace every placeholder.
NODE_ENV=production
KWZG_DB_NAME=kwzg_website
KWZG_DB_USER=kwzg_app
KWZG_DB_PASSWORD=replace-with-a-strong-random-application-password
KWZG_DB_ROOT_PASSWORD=replace-with-a-different-strong-random-root-password
KWZG_APP_PORT=3000
KWZG_BUILD_SITE_URL=https://yizuw.org

# Nuxt server-only runtime
# 首位管理员在数据库迁移后通过交互命令创建：npm run admin:create
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-bytes
NUXT_PUBLIC_SITE_URL=https://yizuw.org
NUXT_TRUSTED_ORIGINS=https://yizuw.org,https://www.yizuw.org
NUXT_PUBLIC_INDEXABLE=false
NUXT_ENABLE_HSTS=false
NUXT_TRUSTED_PROXY_ADDRESSES=replace-with-controlled-reverse-proxy-address

# Only needed when running the Node server outside Compose
NUXT_DATABASE_URL=mysql://kwzg_app:replace-with-a-strong-password@replace-with-database-host:3306/kwzg_website
